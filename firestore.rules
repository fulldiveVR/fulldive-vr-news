rules_version = '2';

// Rules for the `main` database of the full-dive-co project.
//
// The previous ruleset denied everything and relied on privileged SDKs for the
// `bug_reports` collection; that behaviour is kept below. The only addition is
// public read access to `news`, which the Fulldive VR News app reads without
// signing in. Writes stay closed — stories arrive through the seeding script
// and, later, the content service, both of which bypass rules.
service cloud.firestore {
  match /databases/{database}/documents {

    match /news/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
